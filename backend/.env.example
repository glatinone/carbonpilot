# --- Secrets only. Behavioural settings live in code / config, not here. ---

# Google AI Studio key for the Gemini agent. Either name works.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Model used by the agent (optional).
GEMINI_MODEL=gemini-2.5-flash

# Boot-time guard (not a secret): set to true to refuse to start unless
# GEMINI_API_KEY is set, so a demo can never silently fall back to the offline
# deterministic router. Leave unset/false for local work.
CARBONPILOT_REQUIRE_LLM=false

# Optional. With a key, the agent can corroborate a curated emission factor
# against Climatiq's live published library (the `lookup_live_factor` tool) and
# cite it. Without one, that tool reports so and the curated library is used.
# The curated library stays the source of truth for reported numbers either way.
# CLIMATIQ_API_KEY=
# CLIMATIQ_DATA_VERSION=^33

# Leave empty for local SQLite. Set to a Postgres DSN to share one instance.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/carbonpilot

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
